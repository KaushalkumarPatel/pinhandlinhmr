<launch>
    <!-- ARGS -->
    <arg name="model" default="/home/kaushal/catkin_ws/src/yolov8_ros/yolov8_ros/yolov8_ros/best.pt" />
    <arg name="tracker" default="bytetrack.yaml" />
    <arg name="device" default="cuda:0" />
    <arg name="enable" default="True" />
    <arg name="threshold" default="0.1" />
    <arg name="input_image_topic" default="/camera/color/image_raw" />
    <arg name="image_reliability" default="2" />
    <arg name="input_depth_topic" default="/camera/aligned_depth_to_color/image_raw" />
    <arg name="depth_image_reliability" default="2" />
    <arg name="input_depth_info_topic" default="/camera/aligned_depth_to_color/camera_info" />
    <arg name="depth_info_reliability" default="2" />
    <arg name="depth_image_units_divisor" default="1000" />
    <arg name="target_frame" default="camera_depth_optical_frame" />
    <arg name="maximum_detection_threshold" default="0.3" />
    <arg name="namespace" default="yolo" />

    <!-- Nodes -->
    <node pkg="yolov8_ros" type="yolov8_node.py" name="yolov8_node" ns="$(arg namespace)" output="screen">
        <param name="model" value="$(arg model)" />
        <param name="device" value="$(arg device)" />
        <param name="enable" value="$(arg enable)" />
        <param name="threshold" value="$(arg threshold)" />
        <param name="image_reliability" value="$(arg image_reliability)" />
        <remap from="image_raw" to="$(arg input_image_topic)" />
    </node>

<!--    <node pkg="yolov8_ros" type="tracking_node.py" name="tracking_node" ns="$(arg namespace)" output="screen">
        <param name="tracker" value="$(arg tracker)" />
        <param name="image_reliability" value="$(arg image_reliability)" />
        <remap from="image_raw" to="$(arg input_image_topic)" />
    </node> -->

    <node pkg="yolov8_ros" type="detect_3d_node_intel.py" name="detect_3d_node" ns="$(arg namespace)" output="screen">
        <param name="target_frame" value="$(arg target_frame)" />
        <param name="maximum_detection_threshold" value="$(arg maximum_detection_threshold)" />
        <param name="depth_image_units_divisor" value="$(arg depth_image_units_divisor)" />
        <param name="depth_image_reliability" value="$(arg depth_image_reliability)" />
        <param name="depth_info_reliability" value="$(arg depth_info_reliability)" />
        <remap from="depth_image" to="$(arg input_depth_topic)" />
        <remap from="depth_info" to="$(arg input_depth_info_topic)" />
        <!-- <remap from="detections" to="tracking" /> -->
    </node>
 
    <!-- <node pkg="yolov8_ros" type="debug_node.py" name="debug_node" ns="$(arg namespace)" output="screen">
        <param name="image_reliability" value="$(arg image_reliability)" />
        <remap from="image_raw" to="$(arg input_image_topic)" />
        <remap from="detections" to="detections_3d" />
    </node> --> 

    <!-- <node pkg="yolov8_ros" type="realsense2.py" name="point_cloud_processor" ns="$(arg namespace)" output="screen"/>
     -->
</launch>
